{
 "version": 1,
 "name": "Gejje Naada (devotional demo)",
 "bpm": 88,
 "channels": [
  {
   "id": "chmuy7jdc3dcfg2",
   "name": "Tanpura",
   "formula": "v * 0.3*tanh(1.6*(sin(tau*f*t) + 0.6*sin(2*tau*f*t + 0.4*sin(tau*0.7*t)) + 0.35*sin(3*tau*f*t))) * exp(-0.6*t) * (1 - exp(-60*t))",
   "mode": "note",
   "length": 1,
   "release": 2,
   "color": "#c9a227",
   "volume": 0.55,
   "pan": 0,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4lalnl",
   "name": "Gejje Bells",
   "formula": "v * (0.11*(sin(tau*3150*t) + sin(tau*4420*t) + sin(tau*5310*t) + sin(tau*6870*t))*(exp(-22*t) + 0.7*step(t-0.035)*exp(-22*max(0, t-0.035))) + 0.12*noise(t)*exp(-45*t))",
   "mode": "oneshot",
   "length": 0.5,
   "release": 0.1,
   "color": "#ffd166",
   "volume": 0.45,
   "pan": 0.3,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4kfyvu",
   "name": "Temple Bell",
   "formula": "v * 0.4*(sin(tau*440*t) + 0.6*sin(tau*1102*t)*exp(-1.5*t) + 0.4*sin(tau*1726*t)*exp(-2*t) + 0.25*sin(tau*2611*t)*exp(-3*t)) * exp(-0.9*t)",
   "mode": "oneshot",
   "length": 4,
   "release": 0.1,
   "color": "#ffd166",
   "volume": 0.4,
   "pan": -0.25,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4nffwt",
   "name": "Dhol",
   "formula": "v * (0.75*sin(tau*(62*t + 2.2*(1 - exp(-28*t))))*exp(-5*t) + 0.25*noise(t)*exp(-70*t))",
   "mode": "oneshot",
   "length": 0.7,
   "release": 0.1,
   "color": "#e8743b",
   "volume": 0.85,
   "pan": 0,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4l88lm",
   "name": "Tabla Na",
   "formula": "v * ((0.45*sin(tau*510*t) + 0.25*sin(tau*1020*t)*exp(-6*t) + 0.15*sin(tau*1530*t)*exp(-10*t))*exp(-8*t) + 0.15*noise(t)*exp(-90*t))",
   "mode": "oneshot",
   "length": 0.4,
   "release": 0.1,
   "color": "#e0b84a",
   "volume": 0.55,
   "pan": -0.2,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4nh7xe",
   "name": "Tabla Bayan",
   "formula": "v * 0.8*sin(tau*(80*t + 12*t^2))*exp(-3.5*t)*(1 - exp(-300*t))",
   "mode": "oneshot",
   "length": 0.8,
   "release": 0.1,
   "color": "#e0b84a",
   "volume": 0.7,
   "pan": -0.1,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4tcgqn",
   "name": "Flute",
   "formula": "v * (1 - exp(-12*t)) * (0.42*sin(tau*f*t + 0.8*sin(tau*5*t)) + 0.08*sin(2*tau*f*t) + 0.03*noise(t))",
   "mode": "note",
   "length": 1,
   "release": 0.15,
   "color": "#f06292",
   "volume": 0.7,
   "pan": 0.15,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc40tqor",
   "name": "Shehnai",
   "formula": "v * (1 - exp(-15*t)) * 0.4*tanh(3*sin(tau*f*t + 0.5*(1 - exp(-2*t))*sin(tau*5.5*t)))",
   "mode": "note",
   "length": 1,
   "release": 0.2,
   "color": "#f06292",
   "volume": 0.55,
   "pan": -0.15,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4xuf7m",
   "name": "Sitar",
   "formula": "v * 0.4*tanh(2.4*sin(tau*f*t + (1.2 + 0.6*sin(tau*3*t))*exp(-1.5*t)*sin(2*tau*f*t))) * exp(-1.3*t) * (1 - exp(-600*t))",
   "mode": "note",
   "length": 1,
   "release": 0.3,
   "color": "#ffb74d",
   "volume": 0.65,
   "pan": -0.2,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4m20x4",
   "name": "Strings",
   "formula": "v * 0.16*(saw(0.997*f*t) + saw(1.003*f*t) + 0.6*saw(2.001*f*t)) * (1 - exp(-4*t))",
   "mode": "note",
   "length": 1,
   "release": 0.6,
   "color": "#ba68c8",
   "volume": 0.4,
   "pan": 0,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4dbqfa",
   "name": "Warm Pad",
   "formula": "v * 0.3*(sin(tau*f*t) + sin(tau*1.004*f*t) + 0.4*sin(tau*2*f*t)) * (1 - exp(-3*t))",
   "mode": "note",
   "length": 1,
   "release": 0.8,
   "color": "#ba68c8",
   "volume": 0.35,
   "pan": 0,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4uji5s",
   "name": "808 Glide",
   "formula": "v * 0.85*tanh(1.6*sin(tau*(f*t + 1.5*f*(1 - exp(-25*t))/25))) * exp(-1.2*t)",
   "mode": "note",
   "length": 1,
   "release": 0.12,
   "color": "#64b5f6",
   "volume": 0.55,
   "pan": 0,
   "mute": false,
   "solo": false
  },
  {
   "id": "chmuy7jdc4pjv6f",
   "name": "Riser",
   "formula": "(0.2*noise(t) + 0.3*sin(tau*(200*t + 150*t^2))) * (t/2)^2",
   "mode": "oneshot",
   "length": 2,
   "release": 0.1,
   "color": "#90a4ae",
   "volume": 0.45,
   "pan": 0,
   "mute": false,
   "solo": false
  }
